<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <AssemblyName>Hoong-systemScope</AssemblyName>
    <RootNamespace>HoongSystemScope.Cli</RootNamespace>
    <Description>Hoong-systemScope command line interface.</Description>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <SelfContained>false</SelfContained>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Hoong-systemScope.Core\Hoong-systemScope.Core.csproj" />
    <ProjectReference Include="..\Hoong-systemScope.Collectors\Hoong-systemScope.Collectors.csproj" />
    <ProjectReference Include="..\Hoong-systemScope.Analysis\Hoong-systemScope.Analysis.csproj" />
    <ProjectReference Include="..\Hoong-systemScope.Export\Hoong-systemScope.Export.csproj" />
    <ProjectReference Include="..\Hoong-systemScope.Windows\Hoong-systemScope.Windows.csproj" />
  </ItemGroup>

</Project>
