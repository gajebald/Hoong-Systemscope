<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>Hoong-systemScope.Desktop</AssemblyName>
    <RootNamespace>HoongSystemScope.Wpf</RootNamespace>
    <Description>Desktop front end for Hoong-systemScope. Deliberately thin: all presentation logic lives in Hoong-systemScope.ViewModels, which needs no UI framework.</Description>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <SelfContained>false</SelfContained>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>

    <!--
      XML documentation is required across the solution, but a WPF project also
      contains generated partial classes for every XAML file, which carry none.
    -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Hoong-systemScope.App\Hoong-systemScope.App.csproj" />
    <ProjectReference Include="..\Hoong-systemScope.Core\Hoong-systemScope.Core.csproj" />
    <ProjectReference Include="..\Hoong-systemScope.ViewModels\Hoong-systemScope.ViewModels.csproj" />
  </ItemGroup>

</Project>
