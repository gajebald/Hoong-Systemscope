<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <AssemblyName>Hoong-systemScope.Windows</AssemblyName>
    <RootNamespace>HoongSystemScope.Windows</RootNamespace>
    <Description>Windows implementations of the Hoong-systemScope abstractions: registry, Authenticode, Task Scheduler, service catalog, processes and shell links.</Description>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="System.Management" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Hoong-systemScope.Core\Hoong-systemScope.Core.csproj" />
  </ItemGroup>

</Project>
